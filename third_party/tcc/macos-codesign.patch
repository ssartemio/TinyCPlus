--- a/tccmacho.c
+++ b/tccmacho.c
@@ -18,0 +19,3 @@
+#ifdef CONFIG_CODESIGN
+#include <sys/wait.h>
+#endif
@@ -2239,7 +2242,10 @@
-	char command[1024];
-	int retval;
-
-	snprintf(command, sizeof(command), "codesign -f -s - %s", filename);
-	retval = system (command);
-	if (retval == -1 || !(WIFEXITED(retval) && WEXITSTATUS(retval) == 0))
-	    tcc_error ("command failed '%s'", command);
+        int status = 0;
+        pid_t child = fork(), waited;
+        if (child == 0) {
+            execl("/usr/bin/codesign", "codesign", "-f", "-s", "-", filename, (char *)NULL);
+            _exit(127);
+        }
+        if (child < 0) tcc_error("cannot start codesign");
+        do { waited = waitpid(child, &status, 0); } while (waited < 0 && errno == EINTR);
+        if (waited < 0 || !WIFEXITED(status) || WEXITSTATUS(status) != 0)
+            tcc_error("codesign failed for '%s'", filename);
