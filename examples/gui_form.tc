import std.gui;

int main() {
    var window, error = GuiWindow.create(width: 640, height: 360, title: "TinyC+ form");
    if (error != 0)
        return error;
    defer window.destroy();

    GuiTextBox input = GuiTextBox.create("type here");
    defer input.destroy();
    GuiButton closeButton = GuiButton("CLOSE");
    GuiFocus focus = GuiFocus(2);

    while (window.isOpen()) {
        GuiEvent event = window.nextEvent(timeout: 16);
        if (event.kind == 5)
            break;

        GuiRect field = GuiRect(40, 70, 360, 28);
        GuiRect closeArea = GuiRect(40, 116, 120, 30);

        if (event.kind == 3 && event.button == 1 && event.pressed != 0) {
            if (field.contains(event.x, event.y))
                focus.set(0);
            if (closeArea.contains(event.x, event.y))
                focus.set(1);
        }

        bool focusMoved = focus.handleEvent(event);
        if (!focusMoved && focus.isFocused(0))
            input.handleEvent(event);
        if (closeButton.handleEvent(event, closeArea, focus.isFocused(1)))
            window.close();

        Surface canvas = window.surface();
        canvas.clear(Pixel.rgba(18, 24, 32));
        GuiDraw.label(canvas, GuiRect(40, 32, 360, 24), "TINY C+ FORM",
                      Pixel.rgba(230, 237, 243));
        input.draw(canvas, field, focused: focus.isFocused(0));
        closeButton.draw(canvas, closeArea);
        window.present();
    }
    return 0;
}
