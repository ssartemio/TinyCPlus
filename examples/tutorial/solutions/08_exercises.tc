import std.fs;
import std.string;

Error saveScore(string path, int score)
{
    var text = String.fromInt(score);
    defer text.destroy();
    return File.writeAtomic(path, text.view());
}

(int, Error) loadScoreOrZero(string path)
{
    if (!File.exists(path))
        return (0, 0);

    var contents, error = File.readAll(path);
    if (error != 0)
        return (0, error);
    defer contents.destroy();

    var value, parseError = String.parseInt(contents.view());
    if (parseError != 0)
        return (0, parseError);

    return (cast<int>(value), 0);
}

// Keep one score per line; read the existing file before replacing it
// atomically, so a failed replacement leaves the old history intact.
Error appendHistory(string path, int score)
{
    var number = String.fromInt(score);
    defer number.destroy();
    var line = String.concat(number.view(), "\n");
    defer line.destroy();

    if (!File.exists(path))
        return File.writeAtomic(path, line.view());

    var previous, readError = File.readAll(path);
    if (readError != 0)
        return readError;
    defer previous.destroy();

    var updated = String.concat(previous.view(), line.view());
    defer updated.destroy();
    return File.writeAtomic(path, updated.view());
}

int main()
{
    string path = "build/tutorial-solution-status.txt";
    string historyPath = "build/tutorial-solution-history.txt";

    if (File.exists(path))
        File.remove(path);
    if (File.exists(historyPath))
        File.remove(historyPath);

    var missing, missingError = loadScoreOrZero(path);
    assert(missingError == 0 && missing == 0);
    println("missing");

    assert(saveScore(path, 73) == 0);

    var value, error = loadScoreOrZero(path);
    assert(error == 0 && value == 73);
    println(value);

    assert(appendHistory(historyPath, 73) == 0);
    assert(appendHistory(historyPath, 74) == 0);
    var history, historyError = File.readAll(historyPath);
    assert(historyError == 0);
    defer history.destroy();
    assert(history.view() == "73\n74\n");
    println(73);
    println(74);

    assert(File.remove(path) == 0);
    assert(File.remove(historyPath) == 0);
    return 0;
}
