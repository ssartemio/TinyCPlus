import std.net;

async int receiveFour(TcpSocket listener)
{
    var socket = await listener.acceptAsync();
    defer socket.close();

    byte[4] buffer = {};
    int offset = 0;
    // TCP is a byte stream: even a four-byte frame may arrive in pieces.
    while (offset < 4) {
        var received = await socket.readAsync(buffer[offset:4], timeout: 2000);
        if (received <= 0)
            return -1;
        offset += cast<int>(received);
    }

    return buffer[0] + buffer[1] + buffer[2] + buffer[3];
}

int main()
{
    var listener, error = TcpSocket.listen("127.0.0.1", 0);
    assert(error == 0);
    defer listener.close();

    var server = receiveFour(listener);
    defer server.destroy();

    var connecting =
        TcpSocket.connectAsync(
            "127.0.0.1",
            listener.port(),
            timeout: 2000
        );
    defer connecting.destroy();

    var client = connecting.get();
    defer client.close();

    byte[2] firstHalf = {1, 2};
    byte[2] secondHalf = {3, 4};
    assert(client.write(firstHalf[:]) == 2);
    assert(client.write(secondHalf[:]) == 2);

    println(server.get());

    var cancellation = CancellationToken.create();
    defer cancellation.destroy();
    var waiting = listener.acceptAsync(timeout: 2000, token: &cancellation);
    defer waiting.destroy();
    cancellation.cancel();
    var ignored, cancelledError = waiting.result();
    assert(cancelledError != 0);
    return 0;
}
