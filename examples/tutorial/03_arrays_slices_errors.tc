(int, Error) average(Slice<int> values)
{
    if (values.length == 0)
        return (0, 1);

    int total = 0;
    for (value in values)
        total += value;

    return (total / values.length, 0);
}

(int, Error) maximum(Slice<int> values)
{
    if (values.length == 0)
        return (0, 1);

    int result = values[0];

    for (value in values)
        if (value > result)
            result = value;

    return (result, 0);
}

int countWarnings(Slice<int> values, int threshold = 60)
{
    int count = 0;

    for (value in values)
        if (value >= threshold)
            count++;

    return count;
}

int main()
{
    int[6] samples = {45, 48, 50, 62, 70, 57};
    var middle = samples[1:5];

    var mean, meanError = average(middle);
    var max, maxError = maximum(middle);

    assert(meanError == 0);
    assert(maxError == 0);
    assert(mean == 57);
    assert(max == 70);
    assert(countWarnings(samples[:]) == 2);

    int[1] storage = {0};
    var empty = storage[0:0];
    var unused, emptyError = average(empty);
    assert(emptyError != 0);

    println(mean);
    println(max);
    println(countWarnings(samples[:]));
    return 0;
}
