import std.tui;
int main() {
    var window, error = Window.create();
    if (error != 0) { println("A terminal with ANSI support is required."); return error; }
    defer window.destroy();
    var column = Ui.column();
    column.add(Ui.label("TinyC+ TUI    Tab: focus   Enter: activate   Ctrl-Q: quit"));
    var panel = Ui.panel("Message"); var input = Ui.textBox("Hello, TinyC+!"); panel.add(input); column.add(panel);
    var status = Ui.label("Ready");
    var button = Ui.button("Show message");
    button.onClick(() => { var text = input.text(); defer text.destroy(); status.setText(text.view()); });
    column.add(button); column.add(status); window.setContent(column); window.focus(input);
    while (true) {
        window.draw(); window.refresh();
        var event = window.nextEvent();
        if (event.kind == 1 && event.key == 17) break;
        window.dispatch(event);
    }
    return 0;
}
