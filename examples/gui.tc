module examples.gui;
import std.gui;

int main() {
    var surface, error = Surface.create(width: 64, height: 40);
    if (error != 0)
        return error;

    defer surface.destroy();

    uint background = Pixel.rgba(red: 16, green: 24, blue: 32);
    uint accent = Pixel.rgba(red: 90, green: 180, blue: 255);

    surface.clear(background);
    surface.fillRect(x: 8, y: 8, width: 48, height: 24, color: accent);
    surface.rect(x: 4, y: 4, width: 56, height: 32, color: Pixel.rgba(255, 255, 255));
    surface.line(x0: 0, y0: 0, x1: 63, y1: 39, color: Pixel.rgba(255, 90, 90));

    println(surface.checksum());
    return 0;
}
