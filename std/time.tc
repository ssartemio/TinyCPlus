// Reloj y esperas: sleep bloquea al llamador, after devuelve una tarea.
// Las duraciones se expresan en milisegundos; liberar el handle de la tarea.
module std.time;
import std.net;
class Timer {
    static Task<void> after(u64 milliseconds) { Task<void> task; task.handle = tc_timer_after(milliseconds); return task; }
    static void sleep(u64 milliseconds) { tc_sleep_ms(milliseconds); }
    static u64 now() { return tc_clock_ms(); }
}
