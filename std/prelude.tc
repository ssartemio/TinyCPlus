// Declaraciones C incorporadas automáticamente en cada programa.
// Reservar y liberar memoria es explícito; no hay recolector de basura.
// Core C interoperability declarations. No implicit allocation.
extern C {
    void* malloc(size_t size);
    void* calloc(size_t count, size_t size);
    void* realloc(void* pointer, size_t size);
    void free(void* pointer);
    void exit(int code);
}
