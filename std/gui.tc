module std.gui;

/// Packed pixel format is 0xAARRGGBB. Surfaces own their pixel memory explicitly.
extern C {
    uint tc_gui_rgba(uint red, uint green, uint blue, uint alpha);
    void* tc_gui_surface_create(int width, int height, Error* error);
    void tc_gui_surface_destroy(void* surface);
    int tc_gui_surface_width(void* surface);
    int tc_gui_surface_height(void* surface);
    void tc_gui_surface_clear(void* surface, uint color);
    uint tc_gui_surface_get(void* surface, int x, int y);
    void tc_gui_surface_set(void* surface, int x, int y, uint color);
    void tc_gui_fill_rect(void* surface, int x, int y, int width, int height, uint color);
    void tc_gui_rect(void* surface, int x, int y, int width, int height, uint color);
    void tc_gui_line(void* surface, int x0, int y0, int x1, int y1, uint color);
    void tc_gui_blit(void* destination, int dx, int dy, void* source, int sx, int sy, int width, int height);
    int tc_gui_surface_damage(void* surface, int* x, int* y, int* width, int* height);
    void tc_gui_surface_damage_clear(void* surface);
    u64 tc_gui_surface_checksum(void* surface);
    int tc_gui_text_width(string text, int scale);
    void tc_gui_text(void* surface, int x, int y, string text, uint color, int scale);
    void* tc_gui_buffer_create(int width, int height, Error* error);
    void tc_gui_buffer_destroy(void* buffer);
    void* tc_gui_buffer_front(void* buffer);
    void* tc_gui_buffer_back(void* buffer);
    int tc_gui_buffer_present(void* buffer);
    void* tc_gui_window_create(int width, int height, string title, int headless, Error* error);
    int tc_gui_window_width(void* window);
    int tc_gui_window_height(void* window);
    int tc_gui_window_open(void* window);
    void* tc_gui_window_surface(void* window);
    int tc_gui_window_present(void* window);
    Error tc_gui_window_post(void* window, int kind, int key, int x, int y, int width, int height, int button, int pressed, uint codepoint);
    void tc_gui_window_next(void* window, int timeout, int* kind, int* key, int* x, int* y, int* width, int* height, int* button, int* pressed, uint* codepoint);
    void tc_gui_window_close(void* window);
    void tc_gui_window_destroy(void* window);
}

class Pixel {
    static uint rgba(uint red, uint green, uint blue, uint alpha = 255) {
        return tc_gui_rgba(red, green, blue, alpha);
    }
}

class Surface {
    void* handle;
    static (Surface, Error) create(int width, int height) {
        Error error;
        Surface surface(tc_gui_surface_create(width, height, &error));
        return (surface, error);
    }
    int width() { return tc_gui_surface_width(handle); }
    int height() { return tc_gui_surface_height(handle); }
    void clear(uint color) { tc_gui_surface_clear(handle, color); }
    uint getPixel(int x, int y) { return tc_gui_surface_get(handle, x, y); }
    void setPixel(int x, int y, uint color) { tc_gui_surface_set(handle, x, y, color); }
    void fillRect(int x, int y, int width, int height, uint color) {
        tc_gui_fill_rect(handle, x, y, width, height, color);
    }
    void rect(int x, int y, int width, int height, uint color) {
        tc_gui_rect(handle, x, y, width, height, color);
    }
    void line(int x0, int y0, int x1, int y1, uint color) {
        tc_gui_line(handle, x0, y0, x1, y1, color);
    }
    void blit(int x, int y, Surface source, int sourceX = 0, int sourceY = 0,
              int width = -1, int height = -1) {
        int w = width;
        int h = height;
        if (w < 0)
            w = source.width();
        if (h < 0)
            h = source.height();
        tc_gui_blit(handle, x, y, source.handle, sourceX, sourceY, w, h);
    }
    bool damage(int* x, int* y, int* width, int* height) {
        return tc_gui_surface_damage(handle, x, y, width, height) != 0;
    }
    void clearDamage() { tc_gui_surface_damage_clear(handle); }
    u64 checksum() { return tc_gui_surface_checksum(handle); }
    int textWidth(string text, int scale = 1) { return tc_gui_text_width(text, scale); }
    void text(int x, int y, string text, uint color, int scale = 1) {
        tc_gui_text(handle, x, y, text, color, scale);
    }
    void destroy() { tc_gui_surface_destroy(handle); handle = null; }
}

/// Owns two surfaces. front()/back() are borrowed and must not be destroyed separately.
class DoubleBuffer {
    void* handle;
    static (DoubleBuffer, Error) create(int width, int height) {
        Error error;
        DoubleBuffer buffer(tc_gui_buffer_create(width, height, &error));
        return (buffer, error);
    }
    Surface front() { Surface surface(tc_gui_buffer_front(handle)); return surface; }
    Surface back() { Surface surface(tc_gui_buffer_back(handle)); return surface; }
    int present() { return tc_gui_buffer_present(handle); }
    void destroy() { tc_gui_buffer_destroy(handle); handle = null; }
}


/// kind: 1 key, 2 text, 3 mouse, 4 resize, 5 close, 6 custom.
class GuiEvent {
    int kind;
    int key;
    int x;
    int y;
    int width;
    int height;
    int button;
    int pressed;
    uint codepoint;
}

/// Owns a double-buffered native/headless drawing target.
/// surface() is borrowed and must not be destroyed separately.
class GuiWindow {
    void* handle;
    static (GuiWindow, Error) create(int width = 800, int height = 600,
                                     string title = "TinyC+", bool headless = false) {
        Error error;
        GuiWindow window(tc_gui_window_create(width, height, title, headless, &error));
        return (window, error);
    }
    int width() { return tc_gui_window_width(handle); }
    int height() { return tc_gui_window_height(handle); }
    bool isOpen() { return tc_gui_window_open(handle) != 0; }
    Surface surface() { Surface surface(tc_gui_window_surface(handle)); return surface; }
    int present() { return tc_gui_window_present(handle); }
    Error post(GuiEvent event) {
        return tc_gui_window_post(handle, event.kind, event.key, event.x, event.y, event.width,
                                  event.height, event.button, event.pressed, event.codepoint);
    }
    GuiEvent nextEvent(int timeout = 16) {
        GuiEvent event;
        tc_gui_window_next(handle, timeout, &event.kind, &event.key, &event.x, &event.y,
                           &event.width, &event.height, &event.button, &event.pressed,
                           &event.codepoint);
        return event;
    }
    void close() { tc_gui_window_close(handle); }
    void destroy() { tc_gui_window_destroy(handle); handle = null; }
}
