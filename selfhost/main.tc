import std.string;
import std.collections;
import std.fs;
import std.io;
import std.process;
import lexer;
import parser;

/// Stage 1 driver. It grows phase by phase (see docs/SELFHOSTING.md); today it reproduces
/// `tiny --emit-tokens` and `tiny --emit-ast`.
int main()
{
    if (Arguments.count() != 3 || (Arguments.get(1) != "--emit-tokens" && Arguments.get(1) != "--emit-ast"))
    {
        Console.writeErrorLine("usage: tinyc1 --emit-tokens|--emit-ast source.tc");
        return 2;
    }
    bool tokensOnly = Arguments.get(1) == "--emit-tokens";
    string path = Arguments.get(2);
    var source, error = File.readAll(path);
    if (error != 0)
    {
        var text = StringBuilder.create();
        text.append("tiny: cannot read '");
        text.append(path);
        text.append("' (maximum source size 32 MiB)");
        Console.writeErrorLine(text.view());
        return 1;
    }
    defer source.destroy();

    var scanner = Lexer.create(path, source.view());
    defer scanner.destroy();
    scanner.run();

    var output = StringBuilder.create();
    defer output.destroy();
    if (tokensOnly) writeTokens(&scanner.tokens, &output);
    else
    {
        var reader = Parser.create(path, &scanner.tokens);
        defer reader.destroy();
        Node* program = reader.parse();
        dumpNode(program, &output, 0);
    }
    print(output.view());
    return 0;
}
