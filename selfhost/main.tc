import std.string;
import std.collections;
import std.fs;
import std.io;
import std.process;
import lexer;
import ast;
import types;
import parser;

/// Stage 1 driver. It grows phase by phase (see docs/SELFHOSTING.md); today it reproduces
/// `tiny --emit-tokens`, `--emit-ast` and `--emit-types`.
int main()
{
    string mode = Arguments.get(1);
    if (Arguments.count() != 3 || (mode != "--emit-tokens" && mode != "--emit-ast" && mode != "--emit-types"))
    {
        Console.writeErrorLine("usage: tinyc1 --emit-tokens|--emit-ast|--emit-types source.tc");
        return 2;
    }
    string path = Arguments.get(2);
    var source, error = File.readAll(path);
    if (error != 0)
    {
        var text = StringBuilder.create();
        text.append("tiny: cannot read '");
        text.append(path);
        text.append("' (maximum source size 32 MiB)");
        Console.writeErrorLine(text.view());
        return 1;
    }
    defer source.destroy();

    var scanner = Lexer.create(path, source.view());
    defer scanner.destroy();
    scanner.run();

    var output = StringBuilder.create();
    defer output.destroy();
    if (mode == "--emit-tokens") writeTokens(&scanner.tokens, &output);
    else
    {
        Context context;
        var reader = Parser.create(path, &scanner.tokens, &context);
        Node* program = reader.parse();
        if (mode == "--emit-ast") dumpNode(program, &output, 0);
        else dumpTypes(&context, &output);
    }
    print(output.view());
    return 0;
}
